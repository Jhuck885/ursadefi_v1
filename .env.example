# --- Xaman (Xumm) — server only; required for real wallet connect / fee / mint ---
XUMM_API_KEY=your_xumm_api_key
XUMM_API_SECRET=your_xumm_api_secret

# --- Supabase — recommended for persistence ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=  # server only if you add admin routes

# --- Platform fee receiver (XRPL classic address) ---
# Public receive address for platform fees. Set this to YOUR business wallet.
# Do not use a personal spend wallet as the documented default in forks.
PLATFORM_FEE_RECEIVER=rYourFeeReceiverAddressHere
# Optional mirror for client display if needed:
# NEXT_PUBLIC_PLATFORM_FEE_RECEIVER=rYourFeeReceiverAddressHere

# Optional legacy / display-only sample (not used for fees if PLATFORM_FEE_RECEIVER is set)
# NEXT_PUBLIC_XRPL_RECEIVER_ADDRESS=
